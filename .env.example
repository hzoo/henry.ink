# No env file is required. Browser builds use the deployed API and Bluesky search;
# the local API reads public Are.na data without credentials.

# Optional: point a browser dev server at a local API (bun run api).
# VITE_API_URL=http://localhost:3000

# Optional server overrides; these are the defaults.
# API_PORT=3000
# ARCHIVE_CACHE_PATH=./archive-snapshots.db
