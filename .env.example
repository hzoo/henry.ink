# Public browser configuration. Never prefix credentials with VITE_.
# Local development (production builds default to https://api.henry.ink).
VITE_API_URL=http://localhost:3000
# Temporary: anonymous Bluesky search still runs on its existing Worker.
VITE_WORKER_URL=https://bsky-search.henry.ink

# Server-only settings. Keep these on the VPS, not in frontend deployment env.
API_PORT=3000
ARENA_DB_PATH=./api/arena/data/channels.db
ARCHIVE_CACHE_PATH=./archive-snapshots.db
# Optional Are.na credentials, according to the upstream access needed.
ARENA_APP_TOKEN=
ARENA_AUTH_TOKEN=
