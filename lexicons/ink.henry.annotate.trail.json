{
	"lexicon": 1,
	"id": "ink.henry.annotate.trail",
	"defs": {
		"main": {
			"type": "record",
			"description": "A curated collection of annotations",
			"key": "tid",
			"record": {
				"type": "object",
				"required": ["name", "createdAt"],
				"properties": {
					"name": {
						"type": "string",
						"maxGraphemes": 128,
						"maxLength": 1280
					},
					"description": {
						"type": "string",
						"maxGraphemes": 300,
						"maxLength": 3000
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			}
		}
	}
}
