# Cloudflare ranges checked 2026-10-12: https://www.cloudflare.com/ips/
# Trust one CF-supplied address only when the socket peer is Cloudflare.
(henry_api_proxy) {
    @henry_cloudflare {
        remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        header_regexp henry_cf_ip CF-Connecting-IP ^[0-9a-fA-F:.]+$
    }
    route {
        vars henry_client_ip {remote_host}
        vars @henry_cloudflare henry_client_ip {http.request.header.CF-Connecting-IP}
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-For {vars.henry_client_ip}
            header_up -CF-Connecting-IP
            header_up -X-Real-IP
            header_up -Forwarded
        }
    }
}

https://api.henry.ink {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    import henry_api_proxy
}
