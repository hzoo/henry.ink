# User unit in the ~/apps/henry.ink clone on the VPS; ops/deploy.sh links it into
# ~/.config/systemd/user/. Lingering (loginctl enable-linger) starts it at boot.
[Unit]
Description=henry.ink unified API (:3000)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/henry.ink
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun run api
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
# Chrome and jsdom can spike; keep a runaway capture from starving the host.
# MemoryMax and TasksMax apply only where the user manager has those controllers.
MemoryMax=1500M
TasksMax=512
LimitNOFILE=4096

# Capture loads arbitrary pages in Chrome. If one escapes, it finds a read-only
# checkout, an empty home and one writable directory,
# ~/.local/state/henry-ink, which holds the article snapshot cache. The path is
# spelled out because %S and StateDirectory= move between systemd versions.
# PrivateUsers is what makes the mount rules apply in a user unit (systemd 252).
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
BindReadOnlyPaths=%h/apps/henry.ink %h/.bun
BindPaths=%h/.local/state/henry-ink
Environment=ARCHIVE_CACHE_PATH=%h/.local/state/henry-ink/archive-snapshots.db

[Install]
WantedBy=default.target
