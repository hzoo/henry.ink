{
  "name": "henry.ink",
  "description": "see annotations on your current page",
  "private": true,
  "version": "0.0.11",
  "workspaces": [
    "api",
    "extension"
  ],
  "type": "module",
  "scripts": {
    "ink": "vite --config henry-ink/vite.config.ts",
    "ext": "bun --filter atproto-extension dev",
    "api": "bun api/server.ts",
    "build:ink": "vite build --config henry-ink/vite.config.ts",
    "build:ext": "bun --filter atproto-extension build",
    "compile": "tsc --noEmit && tsc --noEmit -p api && tsc --noEmit -p extension && tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test --isolate api src/lib",
    "test:browser": "ARCHIVE_BROWSER_TESTS=1 bun test --isolate --timeout 20000 api src/lib",
    "test:smoke": "NODE_ENV=production bun tests/reader-smoke.ts",
    "verify": "bash scripts/verify.sh",
    "deploy:ink": "bun run verify && wrangler pages deploy henry-ink/dist --project-name=henry-note-reader --branch=main",
    "deploy:api": "bash scripts/deploy-api.sh",
    "deploy:search": "wrangler deploy"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.0",
    "@atcute/bluesky": "^4.0.0",
    "@atcute/bluesky-richtext-segmenter": "^3.0.0",
    "@atcute/client": "^5.0.0",
    "@atcute/identity-resolver": "^2.0.0",
    "@atcute/lexicons": "^2.0.0",
    "@atcute/oauth-browser-client": "^5.0.0",
    "@atcute/password-session": "^1.0.0",
    "@atcute/tid": "^1.1.4",
    "@mozilla/readability": "^0.6.0",
    "@preact/signals": "^2.11.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-svgr": "^5.2.0",
    "wrangler": "^4.156.2"
  }
}
