{
  "name": "henry.ink",
  "description": "see annotations on your current page",
  "private": true,
  "version": "0.0.11",
  "workspaces": [
    "api",
    "extension"
  ],
  "type": "module",
  "scripts": {
    "ink": "vite --config henry-ink/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "ext": "bun --filter atproto-extension dev",
    "api": "bun api/server.ts",
    "build:ink": "vite build --config henry-ink/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build:ext": "bun --filter atproto-extension build",
    "compile": "tsc --noEmit && tsc --noEmit -p api",
    "test": "bun test --isolate api src/lib",
    "test:browser": "ARCHIVE_BROWSER_TESTS=1 bun test --isolate api src/lib",
    "test:smoke": "NODE_ENV=production bun tests/reader-smoke.ts",
    "verify": "bash scripts/verify.sh",
    "deploy:ink": "bun run verify && bunx wrangler pages deploy henry-ink/dist --project-name=henry-note-reader --branch=main",
    "deploy:demo": "bun run build:demo && bunx wrangler pages deploy demo/dist --project-name=annotation-sidebar-demo --branch=main",
    "deploy:api": "bash scripts/deploy-api.sh",
    "deploy:search": "bunx wrangler deploy"
  },
  "dependencies": {
    "@atcute/atproto": "^3.1.12",
    "@atcute/bluesky": "^3.3.5",
    "@atcute/bluesky-richtext-segmenter": "^2.0.4",
    "@atcute/client": "^4.2.2",
    "@atcute/lexicons": "^1.3.1",
    "@atcute/oauth-browser-client": "^1.0.27",
    "@atcute/tid": "^1.1.4",
    "@mozilla/readability": "^0.6.0",
    "@preact/signals": "^2.11.4",
    "@preact/signals-react": "^3.12.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^21.1.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-svgr": "^4.5.0"
  }
}
